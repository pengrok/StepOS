# AI 문제 해석 설정. 이 파일을 .env.local로 복사하고 값을 채웁니다. .env.local은 git에 올라가지 않습니다.

# google 또는 openai (비워 두면 키가 있는 쪽을 씀)
LLM_PROVIDER=
# 비워 두면 google은 gemini-flash-latest, openai는 gpt-5.5
LLM_MODEL=

# 둘 중 쓰는 쪽 하나만 채웁니다
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# 사용량 제한 (비워 두면 기본값)
PARSE_MAX_REQUESTS_PER_10MIN=10
PARSE_MAX_TOKENS_PER_10MIN=40000
PARSE_DAILY_TOKEN_LIMIT=1000000
